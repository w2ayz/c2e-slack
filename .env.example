# Required
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
EDGE_TTS_SCRIPT=/absolute/path/to/tts-converter.js

# Optional — Ollama model (default: llama3.1:8b)
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional — binary paths (defaults assume they are on PATH)
NODE_BIN=node
WHISPER_BIN=whisper
OLLAMA_BIN=ollama

# Optional — temp files
TMP_DIR=/tmp/c2e-app
TMP_RETENTION_HOURS=24

# Optional — logging
LOG_DIR=./logs
LOG_FILE=c2e.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
